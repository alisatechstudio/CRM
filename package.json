{
  "name": "aura-department-store-crm",
  "version": "1.0.0",
  "description": "Full-Stack Enterprise Departmental Store CRM, POS Checkout, Loyalty Engine & Customer 360",
  "main": "server/server.js",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "npm --prefix client run dev",
    "postinstall": "npm --prefix client install",
    "build": "npm --prefix client install && npm --prefix client run build",
    "dev": "node server/server.js"
  },
  "keywords": [
    "crm",
    "retail",
    "department-store",
    "pos",
    "loyalty",
    "rfm-segmentation"
  ],
  "author": "Antigravity",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "mongoose": "^9.11.2"
  },
  "devDependencies": {
    "vite": "^8.3.0"
  }
}
